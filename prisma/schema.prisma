// GorillaSales Enterprise CRM & SFA Database Schema
// Powered by Prisma ORM & PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. TENANCY & USER IDENTITIES
// ==========================================

enum UserRole {
  ADMIN
  MANAGER
  SALES_OFFICER
  DELIVERY_SUPPORT
  DRIVER
}

enum OrderStatus {
  PENDING_APPROVAL // on credit hold: over credit limit or customer has overdue invoices
  CONFIRMED
  DELIVERED // invoice issued
  CANCELLED
}

enum PaymentMethod {
  CASH
  MTN_MOMO
  AIRTEL_MONEY
  BANK_TRANSFER
  CHEQUE
}

enum DocumentType {
  SALES_ORDER
  INVOICE
  PAYMENT
}

enum CustomerType {
  NEW_CUSTOMER
  EXISTING_CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum LookupType {
  CUSTOMER_CATEGORY
  VISIT_OUTCOME
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
  MULTI_SELECT
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  currency         String   @default("RWF")
  timezone         String   @default("Africa/Kigali")
  tin              String? // Rwanda Revenue Authority taxpayer identification number
  vatRate          Decimal  @default(18) @db.Decimal(5, 2) // percent
  pricesIncludeVat Boolean  @default(true) // list prices are VAT-inclusive
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users             User[]
  customers         Customer[]
  products          Product[]
  visitLogs         VisitLog[]
  pipelineStages    PipelineStage[]
  pipelineDeals     PipelineDeal[]
  monthlyTargets    MonthlyTarget[]
  commissionRules   CommissionRule[]
  lookupValues      LookupValue[]
  customFieldDefs   CustomFieldDefinition[]
  customFieldValues CustomFieldValue[]
  auditLogs         AuditLog[]
  priceLists        PriceList[]
  salesOrders       SalesOrder[]
  invoices          Invoice[]
  payments          Payment[]
  documentSequences DocumentSequence[]

  @@map("organizations")
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  passwordHash   String? // bcrypt hash; null = cannot log in until a password is set
  name           String
  initials       String
  role           UserRole  @default(SALES_OFFICER)
  avatarUrl      String?
  phone          String?
  area           String? // home territory, e.g. Kigali Centre
  employeeCode   String? // e.g. GS-OFF-001
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0) // bump to invalidate all of a user's sessions
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedCustomers Customer[]      @relation("CustomerSalesperson")
  visitLogs         VisitLog[]      @relation("VisitSalesperson")
  deals             PipelineDeal[]  @relation("DealSalesperson")
  targets           MonthlyTarget[]
  auditLogs         AuditLog[]
  salesOrders       SalesOrder[]    @relation("OrderSalesperson")
  ordersCreated     SalesOrder[]    @relation("OrderCreatedBy")
  paymentsReceived  Payment[]       @relation("PaymentReceivedBy")

  @@index([organizationId])
  @@map("users")
}

// ==========================================
// 2. CRM CORE ENTITIES
// ==========================================

model Customer {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  code             String?
  category         String // e.g. Hotels, Coffee Shops, Supermarkets
  customerType     CustomerType   @default(EXISTING_CUSTOMER)
  status           CustomerStatus @default(ACTIVE)
  area             String // e.g. Kigali Centre, Remera, Gisozi
  contactPerson    String?
  email            String?
  phone            String?
  address          String?
  tin              String? // taxpayer identification number, printed on invoices
  province         String?
  district         String?
  sector           String?
  salespersonId    String?
  mainProductId    String?
  priceListId      String? // null = product list prices
  monthlyPotential Decimal        @default(0) @db.Decimal(14, 2) // expected monthly purchase value, RWF
  creditLimit      Decimal        @default(0) @db.Decimal(14, 2) // max outstanding balance; 0 = no credit
  paymentTermsDays Int            @default(0) // days to pay after delivery; 0 = cash on delivery
  remarks          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesperson  User?        @relation("CustomerSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  mainProduct  Product?     @relation("CustomerMainProduct", fields: [mainProductId], references: [id], onDelete: SetNull)
  priceList    PriceList?   @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  visitLogs   VisitLog[]
  deals       PipelineDeal[]
  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([salespersonId])
  @@map("customers")
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g. 250G Roasted Coffee, 500G MG
  sku            String?
  category       String // e.g. Roasted Coffee, Instant, Beans
  unitPrice      Decimal  @db.Decimal(14, 2) // list price per unit
  unitOfMeasure  String   @default("KG") // e.g. KG, Pack, Bottle
  weightKg       Float    @default(0) // net coffee weight of one unit, e.g. 0.25 for a 250g pack
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainProductOf  Customer[]       @relation("CustomerMainProduct")
  orderLines     SalesOrderLine[]
  priceListItems PriceListItem[]

  @@index([organizationId])
  @@map("products")
}

// ==========================================
// 3. SALES FORCE AUTOMATION (SFA)
// ==========================================

model VisitLog {
  id               String    @id @default(cuid())
  organizationId   String
  salespersonId    String
  customerId       String
  dateOfVisit      DateTime  @db.Date
  visitOutcome     String // e.g. Order Placed, Visit Only, Follow-up Required
  nextFollowUpDate DateTime? @db.Date
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesperson  User         @relation("VisitSalesperson", fields: [salespersonId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        SalesOrder? // order taken during this visit

  @@index([organizationId])
  @@index([salespersonId])
  @@index([customerId])
  @@index([dateOfVisit])
  @@map("visit_logs")
}

// ==========================================
// 4. PIPELINE & DEAL MANAGEMENT
// ==========================================

model PipelineStage {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g. Lead, Contacted, Proposal, Negotiation, Closing, Won, Lost
  probability    Float    @default(0) // 0 - 100 %
  sortOrder      Int      @default(0)
  color          String? // hex code
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        PipelineDeal[]

  @@index([organizationId])
  @@map("pipeline_stages")
}

model PipelineDeal {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  customerId     String
  salespersonId  String
  stageId        String
  potentialValue Decimal   @default(0) @db.Decimal(14, 2) // probability & weighted value derive from the stage
  lastContact    DateTime  @default(now())
  nextAction     String?
  followUpDate   DateTime? @db.Date
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesperson  User          @relation("DealSalesperson", fields: [salespersonId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([salespersonId])
  @@index([stageId])
  @@map("pipeline_deals")
}

// ==========================================
// 5. TARGETS & COMMISSION ENGINE
// ==========================================

model MonthlyTarget {
  id             String   @id @default(cuid())
  organizationId String
  salespersonId  String
  month          Int // 0 - 11 (January = 0, matches JS Date#getMonth)
  year           Int
  targetAmount   Decimal  @db.Decimal(14, 2) // target order value in RWF (VAT-inclusive)
  targetWeightKg Float    @default(0) // Target Volume in KG
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesperson  User         @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  @@unique([organizationId, salespersonId, month, year])
  @@index([organizationId])
  @@map("monthly_targets")
}

model CommissionRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g. Base Commission, Target Bonus
  ruleType       String // "percentage" | "flat"
  value          Decimal  @db.Decimal(14, 2) // % or flat RWF amount
  thresholdPct   Float    @default(0) // Min target achievement % to trigger rule
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("commission_rules")
}

// ==========================================
// 5b. ORDERS, INVOICES & PAYMENTS
// ==========================================

model PriceList {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g. Hotels & HoReCa, Wholesale
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PriceListItem[]
  customers    Customer[]

  @@unique([organizationId, name])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  productId   String
  unitPrice   Decimal @db.Decimal(14, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

/// Order lifecycle: PENDING_APPROVAL (credit hold) -> CONFIRMED -> DELIVERED (invoice issued), or CANCELLED.
model SalesOrder {
  id               String      @id @default(cuid())
  organizationId   String
  orderNumber      String // e.g. SO-000123
  customerId       String
  salespersonId    String
  visitLogId       String?     @unique
  orderDate        DateTime    @db.Date
  status           OrderStatus @default(CONFIRMED)
  paymentTermsDays Int         @default(0) // copied from the customer when placed
  subtotal         Decimal     @db.Decimal(14, 2) // excluding VAT
  vatAmount        Decimal     @db.Decimal(14, 2)
  total            Decimal     @db.Decimal(14, 2) // including VAT
  notes            String?
  holdReason       String?
  createdById      String
  approvedById     String?
  approvedAt       DateTime?
  deliveredById    String?
  deliveredAt      DateTime?
  cancelledById    String?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesperson  User             @relation("OrderSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  visitLog     VisitLog?        @relation(fields: [visitLogId], references: [id], onDelete: SetNull)
  lines        SalesOrderLine[]
  invoice      Invoice?

  @@unique([organizationId, orderNumber])
  @@index([organizationId, orderDate])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([salespersonId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(14, 2) // price charged per unit (VAT-inclusive when the org's prices are)
  unitWeightKg Float   @default(0) // product weight per unit at time of order
  lineTotal    Decimal @db.Decimal(14, 2) // quantity x unitPrice

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("sales_order_lines")
}

/// Issued when an order is delivered. Balance = total - sum(payments). Voided invoices are excluded.
model Invoice {
  id               String    @id @default(cuid())
  organizationId   String
  invoiceNumber    String // e.g. INV-000123
  orderId          String    @unique
  customerId       String
  issueDate        DateTime  @db.Date
  dueDate          DateTime  @db.Date
  vatRate          Decimal   @db.Decimal(5, 2)
  subtotal         Decimal   @db.Decimal(14, 2)
  vatAmount        Decimal   @db.Decimal(14, 2)
  total            Decimal   @db.Decimal(14, 2)
  ebmReceiptNumber String? // receipt number from the RRA Electronic Billing Machine
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        SalesOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, dueDate])
  @@index([customerId])
  @@map("invoices")
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  paymentNumber  String // receipt number, e.g. RCT-000123
  invoiceId      String
  customerId     String
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String? // MoMo transaction id, bank reference, cheque number
  paidOn         DateTime      @db.Date
  receivedById   String
  notes          String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receivedBy   User         @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, paymentNumber])
  @@index([invoiceId])
  @@index([customerId])
  @@index([organizationId, paidOn])
  @@map("payments")
}

/// Gap-free document numbering per organization (orders, invoices, receipts).
model DocumentSequence {
  organizationId String
  type           DocumentType
  lastNumber     Int          @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, type])
  @@map("document_sequences")
}

// ==========================================
// 6. CONFIGURABLE LOOKUP LISTS
// ==========================================

model LookupValue {
  id             String     @id @default(cuid())
  organizationId String
  type           LookupType
  label          String
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, label])
  @@index([organizationId, type])
  @@map("lookup_values")
}

// ==========================================
// 7. TWENTY CRM-STYLE DYNAMIC CUSTOM FIELDS
// ==========================================

model CustomFieldDefinition {
  id             String    @id @default(cuid())
  organizationId String
  entityType     String // "CUSTOMER" | "VISIT_LOG" | "DEAL" | "PRODUCT"
  name           String // e.g. "Coffee Roaster Model"
  fieldKey       String // e.g. "coffee_roaster_model"
  fieldType      FieldType @default(TEXT)
  options        Json? // Array of select options for SELECT / MULTI_SELECT types
  isRequired     Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@unique([organizationId, entityType, fieldKey])
  @@index([organizationId])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                String   @id @default(cuid())
  organizationId    String
  entityType        String // "CUSTOMER" | "VISIT_LOG" | "DEAL" | "PRODUCT"
  entityId          String // ID of target Customer, VisitLog, etc.
  fieldDefinitionId String
  value             Json // Stored value (String, Number, Array, Boolean)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, fieldDefinitionId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("custom_field_values")
}

// ==========================================
// 8. AUDIT & ENTERPRISE COMPLIANCE
// ==========================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // e.g. "CREATE_VISIT_LOG", "UPDATE_COMMISSION_RULE"
  entityType     String // e.g. "VisitLog", "CommissionRule"
  entityId       String?
  payload        Json? // Snapshot of change or metadata
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
